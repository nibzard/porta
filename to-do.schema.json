{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable implementation backlog",
  "description": "Version-one work derived from SPEC.md. Lower priority numbers run first. Among eligible tasks, sort by priority and then id. A task is eligible when every depends_on task is done. Deferred and optional features are excluded unless needed by a selected adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_files",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "priority",
        "status",
        "details",
        "depends_on",
        "spec_sections",
        "acceptance_criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "status": {
          "enum": [
            "todo",
            "doing",
            "blocked",
            "done"
          ]
        },
        "details": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{3}$"
          }
        },
        "spec_sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
